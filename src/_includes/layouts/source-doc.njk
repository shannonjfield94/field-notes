---
layout: layouts/base.njk
---

<article class="source-doc-page">

  <header class="source-doc-header">
    <div class="source-doc-header-inner">
      {% if back_url %}<a href="{{ back_url }}" class="source-doc-backlink">← {{ back_label | default("Back") }}</a>{% endif %}
      <h1 class="source-doc-title">{{ title }}</h1>
      {% if intro %}<p class="source-doc-intro">{{ intro | safe }}</p>{% endif %}
    </div>
  </header>

  <div class="source-doc-body">

    {% if image %}
    <figure class="source-doc-image">
      <img src="{{ image.src }}" alt="{{ image.alt }}">
      {% if image.caption %}<figcaption>{{ image.caption }}</figcaption>{% endif %}
    </figure>
    {% endif %}

    <section class="source-doc-transcript">
      <h2>Transcript</h2>
      {{ content | safe }}
    </section>

  </div>

  {% citeReferences %}

  <footer class="source-doc-footer">
    {% if back_url %}<a href="{{ back_url }}" class="source-doc-backlink">← {{ back_label | default("Back") }}</a>{% endif %}
  </footer>

</article>