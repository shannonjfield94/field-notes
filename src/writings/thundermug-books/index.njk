{% set sidebar_items = [
  { label: "Ancestors", url: "/people/" },
  { label: "Families", url: "/families/" },
  { label: "Index", url: "/index/" },
  { label: "Writings", url: "/writings/" }
] %}

{#- Gathers the books (every writing tagged group: "thundermug-books") so they can be listed in publication order. -#}
{%- set books = [] %}
{%- for e in collections.writings %}{% if e.data.group == "thundermug-books" %}{% set _ = books.push(e) %}{% endif %}{% endfor %}

<div class="section-layout">
  {% include "partials/section-sidebar.njk" %}

  <div class="section-content">
    <div class="page-header">
      <p class="section-breadcrumb"><a href="/writings/">Writings</a></p>
      <h1>Thundermug Books</h1>
      {# DRAFT intro copy: Shannon to rewrite in her own words. #}
      <p class="page-intro">
        John Richard Jackson wrote a weekly column, "Once Around the Thundermug," for The Mineral County Miner, Creede's weekly newspaper. Between 1993 and the early 2000s he gathered his stories and verses into six self-published books, writing as Thundermug. All six are long out of print.
      </p>
      <p class="page-intro">
        B&amp;B Printing of Gunnison, Colorado, their publisher, supplied PDFs of all six. With his sister's blessing as his sole heir, each is reproduced here exactly as John wrote it, in the order the books were published.
      </p>
    </div>

    <div class="journal-list">
      {%- for entry in books | sort(false, true, "data.book_order") %}
      <article class="journal-card">
        <h2 class="journal-card__title">
          <a href="{{ entry.url }}">{{ entry.data.title }}</a>
        </h2>
        <p class="journal-card__date">Book {{ entry.data.book_order }} · {{ entry.data.book_year }}</p>
        {% if entry.data.excerpt %}
        <p class="journal-card__excerpt">{{ entry.data.excerpt }}</p>
        {% endif %}
        {% if entry.data.sensitivity_tags and entry.data.sensitivity_tags.length %}
        <div class="journal-card__sensitivity-flag">
          <span class="journal-sensitivity-label">Heads up:</span>
          {% for s in entry.data.sensitivity_tags %}<span class="journal-sensitivity-tag">{{ s }}</span>{% endfor %}
        </div>
        {% endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</div>
